{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "update" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "branch name", "integration_id": 15368 },
          { "context": "commit messages", "integration_id": 15368 },
          { "context": "check (ubuntu-latest)", "integration_id": 15368 },
          { "context": "check (macos-latest)", "integration_id": 15368 },
          { "context": "check (windows-latest)", "integration_id": 15368 },
          { "context": "e2e (ubuntu-latest)", "integration_id": 15368 },
          { "context": "e2e (macos-latest)", "integration_id": 15368 },
          { "context": "mobile", "integration_id": 15368 },
          { "context": "android", "integration_id": 15368 }
        ]
      }
    }
  ],
  "bypass_actors": [{ "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request" }]
}
