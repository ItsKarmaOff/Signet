{
  // Ni DOM ni types Node : ce code doit tourner dans Electron (main et rendu) et dans React Native (Hermes).
  // `src/globals.d.ts` déclare le strict nécessaire (URL).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
