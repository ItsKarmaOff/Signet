    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^26.5.7",
    "tldts": "^7.4.17"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
