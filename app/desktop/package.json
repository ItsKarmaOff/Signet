{
  "name": "@signet/desktop",
  "productName": "Signet",
  "version": "0.4.0",
  "desktopName": "signet.desktop",
  "description": "A sidebar-first web browser for macOS, Linux and Windows: spaces, command bar, split view, Little Signet and Peek.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/ItsKarmaOff/Signet",
  "author": {
    "name": "Christophe Vandevoir",
    "email": "115950432+ItsKarmaOff@users.noreply.github.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "dist": "electron-vite build && electron-builder --config electron-builder.mjs --mac",
    "dist:linux": "electron-vite build && electron-builder --config electron-builder.mjs --linux AppImage --x64",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.mjs --win nsis --x64",
    "icons": "node scripts/icons/generate.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.64.1",
    "@signet/shared": "*",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "emojibase-data": "^18.0.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "bonjour-service": "^1.4.4",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  }
}
